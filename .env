# Every build resolves each tool to its latest release (scripts/versions.sh).
# Uncomment a line only if you need to pin that tool to a specific version.
#ALPINE_VERSION=3.24.4
#GO_VERSION=1.27.3
#KUBE_VERSION=1.37.2
#HELM_VERSION=4.3.1
#HELM_PUSH_VERSION=0.11.1
#TERRAFORM_VERSION=1.17.1
#YQ_VERSION=4.54.2
#PIP_VERSION=26.3
#SETUPTOOLS_VERSION=84.2.1
#TEMPLER_VERSION=1.1.0.post2
#JINJA_VERSION=3.1.6

# Alpine packages taken from edge because stable has not shipped their CVE
# fixes yet (default list is in the Dockerfile). Set to empty to disable:
#ALPINE_EDGE_PACKAGES=
